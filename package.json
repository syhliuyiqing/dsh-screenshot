{
  "name": "dsh-screenshot",
  "version": "1.0.0",
  "private": true,
  "description": "Hides the DSH window, lets you drag a rectangle over the screen, and drops the cropped PNG straight into the composer as a draft image.",
  "type": "module",
  "license": "MIT",
  "author": "syhliuyiqing",
  "homepage": "https://github.com/syhliuyiqing/dsh-screenshot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syhliuyiqing/dsh-screenshot.git"
  },
  "bugs": {
    "url": "https://github.com/syhliuyiqing/dsh-screenshot/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "screenshot",
    "region-capture"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "capture.ps1",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
